# Modelo de variáveis de ambiente para o docker-compose.yml
# Uso: cp .env.example .env   e depois troque os valores no .env
# O arquivo .env NUNCA deve ir para o Git (já está no .gitignore)

# Banco de dados PostgreSQL
DB_USER=technova
DB_PASSWORD=troque_esta_senha
DB_NAME=reservas

# Porta da API na sua máquina
API_PORT=3000
